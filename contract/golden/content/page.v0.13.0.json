  "title": "Northwind Web Studio — Websites that mean business",
  "status": "published",
  "description": "A boutique web studio in San Francisco: strategy, design, and hand-built static sites that win you more business.",
  "translationGroup": "home",
  "nav": {
    "title": "Home",
    "slots": [
      "header"
    ],
    "order": 1
  },
  "source": "<div class=\"hidden\">{{sw-control target=\"page.title\" as=\"text\" label=\"Page title\"}} {{sw-control target=\"page.description\" as=\"textarea\" label=\"Meta description\"}} {{sw-control target=\"page.data.spotlight\" as=\"dataset\" label=\"Spotlight project\"}} {{sw-control target=\"page.data.demo_team\" as=\"number\" label=\"Team size\"}} {{sw-control target=\"page.data.demo_accent\" as=\"color\" label=\"Brand accent\"}} {{sw-control target=\"page.data.demo_launch\" as=\"date\" label=\"Next opening\"}} {{sw-control target=\"page.data.demo_status\" as=\"select\" options=\"Open for projects, Booked, Waitlist\" label=\"Availability\"}}</div>\n<!-- The hero is a live shader-bg: the WebGL runtime paints a CI-themed animated field BEHIND the\ncontent (a legibility scrim keeps the white text crisp); the nw-aurora class is the JS-off /\nreduced-motion fallback, the same brand gradient the component would draw. -->\n<section class=\"nw-aurora relative overflow-hidden text-white\" data-sw-component=\"shader-bg\" data-preset=\"mesh-gradient\" data-speed=\"0.5\" data-intensity=\"0.45\">\n  <div data-sw-part=\"overlay\" class=\"bg-neutral/35\" aria-hidden=\"true\"></div>\n  <div class=\"nw-grid-bg pointer-events-none absolute inset-0\" aria-hidden=\"true\"></div>\n  <div class=\"relative mx-auto grid max-w-6xl items-center gap-14 px-6 pb-36 pt-20 lg:grid-cols-[1.05fr_0.95fr] lg:pb-44 lg:pt-28\">\n    <div class=\"nw-rise\">\n      <span class=\"inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-1.5 text-sm font-medium text-white/90 backdrop-blur\"><span class=\"inline-block h-2 w-2 rounded-full bg-secondary\"></span><span data-sw-translate=\"home.eyebrow\">Boutique web studio · San Francisco</span></span>\n      <h1 class=\"mt-7 text-5xl font-bold leading-[1.04] tracking-tight sm:text-6xl xl:text-7xl\" data-sw-translate=\"home.headline\">Websites that win you more business.</h1>\n      <p class=\"mt-6 max-w-md text-lg leading-relaxed text-white/65\" data-sw-translate=\"home.subhead\">We design and build fast, beautiful sites for ambitious brands — strategy, design, and engineering under one roof.</p>\n      <div class=\"mt-9 flex flex-wrap gap-3\">\n        <a class=\"btn\" href=\"/contact\" data-sw-href=\"href_contact\"><span data-sw-translate=\"nav_cta\">Start a project</span> <svg class=\"h-5 w-5\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\" /><path d=\"m12 5 7 7-7 7\" /></svg></a>\n        <a class=\"btn btn-ghost\" href=\"/work\" data-sw-href=\"href_work\"><span data-sw-translate=\"home.cta_work\">See our work</span> <svg class=\"h-5 w-5\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\" /><path d=\"M7 17 17 7\" /></svg></a>\n      </div>\n    </div>\n    <!-- Decorative only: a gentle scroll-linked drift gives the hero art depth against the shader\n    field. The inner card keeps its CSS nw-float; parallax rides the wrapper so they don't clash. -->\n    <div class=\"relative hidden lg:block\" data-sw-parallax-translate=\"0,-44\">\n      <div class=\"absolute -inset-8 rounded-full bg-primary/30 blur-3xl\" aria-hidden=\"true\"></div>\n      <div class=\"nw-float relative overflow-hidden rounded-3xl shadow-2xl shadow-black/40 ring-1 ring-white/20 nw-zoom\">\n        <!-- Lazy-loaded: the URL lives in data-src → the runtime swaps it to src on scroll-in. -->\n        <img class=\"h-full w-full object-cover\" data-src=\"/media/example/PDHKkU-hero.png\" alt=\"{{sw-translate \"home.hero_alt\"}}\" />\n      </div>\n      <!-- Floating chip REUSES the stats-band keys (stat3_n / stat3_l) on purpose: one\n      translated value renders in both spots, so locale variants stay in sync for free. -->\n      <div class=\"absolute -bottom-6 -left-8 flex items-center gap-3 rounded-2xl border border-white/15 bg-white/10 px-5 py-4 shadow-xl backdrop-blur-xl\">\n        <span class=\"inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-secondary text-white\"><svg class=\"h-5 w-5\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 14 4-4\" /><path d=\"M3.34 19a10 10 0 1 1 17.32 0\" /></svg></span>\n        <span><span class=\"block text-xl font-bold leading-none\" data-sw-text=\"stat3_n\">100</span><span class=\"mt-1 block text-xs text-white/60\" data-sw-translate=\"home.stat3_l\">Avg. Lighthouse score</span></span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"relative z-10 mx-auto -mt-20 max-w-5xl px-6 lg:-mt-24\">\n  <dl class=\"grid grid-cols-2 gap-y-10 rounded-3xl border border-base-200/80 bg-base-100/95 px-6 py-10 shadow-2xl shadow-neutral/10 backdrop-blur-xl md:grid-cols-4\">\n    <div class=\"text-center\" data-sw-animation=\"fade-up\"><dt class=\"bg-gradient-to-br from-primary to-secondary bg-clip-text text-4xl font-bold tracking-tight text-transparent\" data-sw-text=\"stat1_n\">120+</dt><dd class=\"mt-2 text-xs font-medium uppercase tracking-wider text-base-content/50\" data-sw-translate=\"home.stat1_l\">Sites shipped</dd></div>\n    <div class=\"text-center\" data-sw-animation=\"fade-up\" data-sw-delay=\"100\"><dt class=\"bg-gradient-to-br from-primary to-secondary bg-clip-text text-4xl font-bold tracking-tight text-transparent\" data-sw-text=\"stat2_n\">9</dt><dd class=\"mt-2 text-xs font-medium uppercase tracking-wider text-base-content/50\" data-sw-translate=\"home.stat2_l\">Years in business</dd></div>\n    <div class=\"text-center\" data-sw-animation=\"fade-up\" data-sw-delay=\"200\"><dt class=\"bg-gradient-to-br from-primary to-secondary bg-clip-text text-4xl font-bold tracking-tight text-transparent\" data-sw-text=\"stat3_n\">100</dt><dd class=\"mt-2 text-xs font-medium uppercase tracking-wider text-base-content/50\" data-sw-translate=\"home.stat3_l\">Avg. Lighthouse score</dd></div>\n    <div class=\"text-center\" data-sw-animation=\"fade-up\" data-sw-delay=\"300\"><dt class=\"bg-gradient-to-br from-primary to-secondary bg-clip-text text-4xl font-bold tracking-tight text-transparent\" data-sw-text=\"stat4_n\">38%</dt><dd class=\"mt-2 text-xs font-medium uppercase tracking-wider text-base-content/50\" data-sw-translate=\"home.stat4_l\">Avg. lift in enquiries</dd></div>\n  </dl>\n</section>\n\n\n\n<section class=\"mx-auto max-w-6xl px-6 pt-24\">\n  <div class=\"grid gap-12 lg:grid-cols-2 lg:items-center\">\n    <div data-sw-animation=\"fade-right\">\n      <span class=\"text-sm font-semibold uppercase tracking-[0.18em] text-primary\" data-sw-translate=\"home.why_eyebrow\">Why Northwind</span>\n      <h2 class=\"mt-4 text-3xl font-bold tracking-tight sm:text-4xl\" data-sw-translate=\"home.why_title\">Senior people, no hand-offs, no surprises</h2>\n      <p class=\"mt-4 text-lg leading-relaxed text-base-content/60\" data-sw-translate=\"home.why_sub\">You work directly with the designers and engineers building your site — start to finish.</p>\n    </div>\n    <ul class=\"grid list-none gap-4 p-0 sm:grid-cols-2\" data-sw-animation=\"fade-left\">\n      <li class=\"flex items-start gap-3 rounded-2xl border border-base-200 bg-base-100 px-4 py-3.5 shadow-sm\"><span class=\"mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary\"><svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\" /></svg></span><span class=\"font-medium text-base-content/80\" data-sw-translate=\"home.why1\">Fixed scope &amp; timeline</span></li>\n      <li class=\"flex items-start gap-3 rounded-2xl border border-base-200 bg-base-100 px-4 py-3.5 shadow-sm\"><span class=\"mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary\"><svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\" /></svg></span><span class=\"font-medium text-base-content/80\" data-sw-translate=\"home.why2\">Perfect Lighthouse scores</span></li>\n      <li class=\"flex items-start gap-3 rounded-2xl border border-base-200 bg-base-100 px-4 py-3.5 shadow-sm\"><span class=\"mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary\"><svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\" /></svg></span><span class=\"font-medium text-base-content/80\" data-sw-translate=\"home.why3\">You can edit the content yourself</span></li>\n      <li class=\"flex items-start gap-3 rounded-2xl border border-base-200 bg-base-100 px-4 py-3.5 shadow-sm\"><span class=\"mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary\"><svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\" /></svg></span><span class=\"font-medium text-base-content/80\" data-sw-translate=\"home.why4\">Accessible &amp; SEO-ready</span></li>\n      <li class=\"flex items-start gap-3 rounded-2xl border border-base-200 bg-base-100 px-4 py-3.5 shadow-sm\"><span class=\"mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary\"><svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\" /></svg></span><span class=\"font-medium text-base-content/80\" data-sw-translate=\"home.why5\">Hosting-friendly static export</span></li>\n      <li class=\"flex items-start gap-3 rounded-2xl border border-base-200 bg-base-100 px-4 py-3.5 shadow-sm\"><span class=\"mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary\"><svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\" /></svg></span><span class=\"font-medium text-base-content/80\" data-sw-translate=\"home.why6\">Ongoing care plans</span></li>\n    </ul>\n  </div>\n</section>\n\n<section class=\"mx-auto max-w-6xl px-6 py-24\">\n  <div class=\"max-w-2xl\" data-sw-animation=\"fade-up\">\n    <h2 class=\"text-3xl font-bold tracking-tight sm:text-4xl\" data-sw-translate=\"home.svc_title\">Everything you need under one roof</h2>\n    <p class=\"mt-4 text-lg leading-relaxed text-base-content/60\" data-sw-translate=\"home.svc_sub\">Strategy, design, and engineering — no hand-offs, no agencies-of-agencies.</p>\n  </div>\n  <div class=\"mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3\" data-sw-animation=\"fade-up\" data-sw-delay=\"100\">\n    {{#each dataset.services}}\n    <div class=\"card nw-card border border-base-200 bg-base-100 shadow-sm hover:border-primary/30 hover:shadow-xl hover:shadow-primary/5\">\n      <div class=\"card-body p-7\">\n        <span class=\"inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-primary/15 to-secondary/15 text-primary\">{{sw-icon icon \"h-6 w-6\"}}</span>\n        <h3 class=\"mt-4 text-lg font-bold tracking-tight\">{{title}}</h3>\n        <p class=\"text-[0.95rem] leading-relaxed text-base-content/60\">{{summary}}</p>\n        <p class=\"mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-primary\"><svg class=\"h-3.5 w-3.5\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z\" /><circle cx=\"7.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\" /></svg> {{price}}</p>\n      </div>\n    </div>\n    {{/each}}\n  </div>\n</section>\n\n<section class=\"overflow-hidden bg-base-200/60\">\n  <div class=\"mx-auto grid max-w-6xl items-center gap-14 px-6 py-24 lg:grid-cols-2\">\n    <!-- Case-study spotlight: a KEYED dataset lookup (item.projects.<id>), with the id in\n    page.data so each locale variant points at its own entry (proj-harbor / proj-harbor-de). -->\n    {{#with (lookup @root.item.projects @root.page.data.spotlight)}}\n    <div class=\"relative\" data-sw-animation=\"zoom-in\">\n      <div class=\"absolute -inset-6 -rotate-2 rounded-[2rem] bg-gradient-to-br from-primary/20 to-secondary/20\" aria-hidden=\"true\"></div>\n      <div class=\"nw-zoom relative overflow-hidden rounded-3xl shadow-2xl shadow-neutral/20\">\n        <img src=\"{{sw-url image}}\" alt=\"{{title}}\" class=\"h-full w-full object-cover\" loading=\"lazy\" />\n        <span class=\"absolute left-4 top-4 rounded-full bg-black/45 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur\">{{category}}</span>\n      </div>\n    </div>\n    <div data-sw-animation=\"fade-left\">\n      <span class=\"text-sm font-semibold uppercase tracking-[0.18em] text-primary\" data-sw-translate=\"home.spot_eyebrow\">Case study</span>\n      <h2 class=\"mt-4 text-3xl font-bold tracking-tight sm:text-4xl\">{{title}}</h2>\n      <p class=\"mt-3 text-sm font-medium text-base-content/45\">{{client}} · {{category}} · {{year}}</p>\n      <p class=\"mt-5 text-lg leading-relaxed text-base-content/70\">{{summary}}</p>\n      <a class=\"nw-underline mt-7 inline-flex items-center gap-1.5 font-semibold text-primary no-underline\" href=\"/work\" data-sw-href=\"href_work\"><span data-sw-translate=\"home.spot_link\">See the full portfolio</span> <svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\" /><path d=\"m12 5 7 7-7 7\" /></svg></a>\n    </div>\n    {{/with}}\n  </div>\n</section>\n\n<section class=\"mx-auto max-w-6xl px-6 py-24\">\n  <div class=\"flex flex-wrap items-end justify-between gap-4\" data-sw-animation=\"fade-up\">\n    <h2 class=\"text-3xl font-bold tracking-tight sm:text-4xl\" data-sw-translate=\"home.work_title\">Selected work</h2>\n    <a class=\"nw-underline inline-flex items-center gap-1.5 font-semibold text-primary no-underline\" href=\"/work\" data-sw-href=\"href_work\"><span data-sw-translate=\"home.work_link\">View all projects</span> <svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\" /><path d=\"m12 5 7 7-7 7\" /></svg></a>\n  </div>\n  <div class=\"mt-12 grid gap-7 md:grid-cols-3\" data-sw-animation=\"fade-up\" data-sw-delay=\"100\">\n    {{#each dataset.projects}}\n    <a class=\"group card nw-card overflow-hidden border border-base-200 bg-base-100 no-underline shadow-sm hover:border-primary/30 hover:shadow-xl hover:shadow-primary/5 nw-zoom\" href=\"/work\" data-sw-href=\"href_work\">\n      <figure class=\"relative aspect-[4/3] overflow-hidden\">\n        <img src=\"{{sw-url image}}\" alt=\"{{title}}\" class=\"h-full w-full object-cover\" loading=\"lazy\" />\n        <span class=\"absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100\" aria-hidden=\"true\"></span>\n        <span class=\"absolute right-4 top-4 inline-flex h-9 w-9 translate-y-1 items-center justify-center rounded-full bg-white/90 text-neutral opacity-0 shadow transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100\"><svg class=\"h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\" /><path d=\"M7 17 17 7\" /></svg></span>\n      </figure>\n      <div class=\"card-body p-6\">\n        <span class=\"text-xs font-semibold uppercase tracking-wider text-primary\">{{category}}</span>\n        <h3 class=\"text-lg font-bold tracking-tight\">{{title}}</h3>\n        <p class=\"text-sm leading-relaxed text-base-content/55\">{{summary}}</p>\n      </div>\n    </a>\n    {{/each}}\n  </div>\n</section>\n\n<section class=\"relative overflow-hidden bg-neutral text-neutral-content\">\n  <div class=\"pointer-events-none absolute -left-32 top-0 h-96 w-96 rounded-full bg-primary/25 blur-3xl\" aria-hidden=\"true\" data-sw-parallax-translate=\"-60,60\"></div>\n  <div class=\"pointer-events-none absolute -right-32 bottom-0 h-96 w-96 rounded-full bg-secondary/20 blur-3xl\" aria-hidden=\"true\" data-sw-parallax-translate=\"60,-60\"></div>\n  <div class=\"relative mx-auto max-w-4xl px-6 py-24\">\n    <h2 class=\"text-center text-3xl font-bold tracking-tight sm:text-4xl\" data-sw-animation=\"fade-up\" data-sw-translate=\"home.tst_title\">Loved by the brands we build for</h2>\n    <!-- First-party CAROUSEL: scroll-snap track (swipeable without JS); the runtime adds arrows,\n    dots, keyboard nav, and gentle autoplay (pausing on hover/focus/reduced-motion). -->\n    <div class=\"relative mt-12\" data-sw-component=\"carousel\" data-sw-block=\"Carousel\" data-autoplay=\"true\" data-interval=\"6000\" data-arrows=\"circle\" data-sw-animation=\"fade-up\" data-sw-delay=\"100\">\n      <div data-sw-part=\"track\">\n        {{#each dataset.testimonials}}\n        <figure data-sw-part=\"slide\" class=\"px-1 sm:px-10\">\n          <div class=\"rounded-3xl border border-white/10 bg-white/5 p-10 backdrop-blur\">\n            <div class=\"flex flex-col items-center text-center\">\n              <div class=\"flex gap-1 text-accent\"><svg class=\"h-4 w-4 fill-current\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\" /></svg><svg class=\"h-4 w-4 fill-current\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\" /></svg><svg class=\"h-4 w-4 fill-current\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\" /></svg><svg class=\"h-4 w-4 fill-current\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\" /></svg><svg class=\"h-4 w-4 fill-current\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\" /></svg></div>\n              <blockquote class=\"mt-5 max-w-xl text-xl font-medium leading-relaxed text-neutral-content/90 sm:text-2xl\">{{quote}}</blockquote>\n              <figcaption class=\"mt-6 text-sm\"><span class=\"font-semi