{
  "name": "sitewright-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Sitewright — OSS website development platform for web-development agencies.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "set-version": "node scripts/set-version.mjs",
    "export-example": "node scripts/export-example.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@tailwindcss/oxide", "sharp"],
    "overrides": {
      "hono@<4.12.27": ">=4.12.27",
      "form-data@<4.0.6": "^4.0.6",
      "body-parser@<2.3.0": "^2.3.0",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "nodemailer@<9.0.1": ">=9.0.1",
      "brace-expansion@<5.0.8": "^5.0.8",
      "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
      "shell-quote@<1.9.0": "^1.9.0",
      "fast-uri@<3.1.4": "3.1.4",
      "find-my-way@<9.7.0": "^9.7.0",
      "postcss@<8.5.18": "^8.5.18",
      "@hono/node-server@<2.0.5": "^2.0.5"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
