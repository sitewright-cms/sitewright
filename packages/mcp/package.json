{
  "name": "@sitewright/mcp",
  "version": "0.49.0",
  "description": "Sitewright MCP tool surface: a project's content operations as MCP tools, shared by the API's remote HTTP /mcp endpoint. Also ships the DEPRECATED sitewright-mcp stdio bridge bin (retired, kept for existing installs).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sitewright-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sitewright/blocks": "workspace:*",
    "@sitewright/schema": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
