{{!-- META {"path":"concepts","title":"Concepts","description":"How pages, templates, snippets, slots, datasets and brand tokens fit together.","parent":"docs","nav":{"title":"Concepts","slots":["custom"],"order":2,"dropdown":true},"data":{"icon":"lightbulb"}} --}}
{{> page-hero parent=page.parent}}
<div class="ws-docs">
  {{> docs-nav}}
  <div class="ws-article">
    <ul class="list-none space-y-3 p-0">
      {{#each page.children}}
      <li><a class="ws-tile block rounded-2xl border border-base-content/10 bg-base-100 p-5 no-underline" href="{{sw-url path}}"><span class="font-heading text-lg font-bold text-base-content">{{title}}</span><span class="mt-1 block text-sm text-base-content/70">{{description}}</span></a></li>
      {{/each}}
    </ul>
  </div>
</div>
