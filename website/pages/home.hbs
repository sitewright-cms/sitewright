    <span class="tk-tag">&lt;p&gt;</span><span class="tk-hb">\{{summary}}</span><span class="tk-tag">&lt;/p&gt;</span>
  <span class="tk-tag">&lt;/article&gt;</span>
  <span class="tk-hb">\{{/each}}</span>
<span class="tk-tag">&lt;/div&gt;</span></code></pre>
    </div>
    <div class="sw-border-beam relative rounded-2xl border border-base-content/10 bg-base-100 p-5 [--sw-beam-width:2px]" data-sw-animation="fade-up" data-sw-delay="120">
      <div class="flex items-center gap-2 text-xs text-base-content/60">{{sw-icon "eye" "h-4 w-4"}} The same code, rendered on this page <span class="ml-auto rounded-full bg-accent/15 px-2 py-0.5 font-medium text-accent">live</span></div>
      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        {{#each dataset.home_services}}
        <article class="rounded-xl bg-base-200 p-5" data-sw-animation="fade-up" data-sw-delay="{{sw-stagger @index 90}}">
          {{sw-icon icon "h-7 w-7 ws-ink"}}
          <h3 class="mt-4 font-heading text-lg font-bold">{{title}}</h3>
          <p class="mt-1 text-sm leading-relaxed text-base-content/70">{{summary}}</p>
        </article>
        {{/each}}
      </div>
      <p class="mt-5 text-sm text-base-content/60">In the editor, each card opens its row for editing with a click.</p>
    </div>
  </div>
</section>

