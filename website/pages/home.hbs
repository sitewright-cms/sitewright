{{!-- ═══ CODE → LIVE RESULT. The right side is REAL: it renders the home_services dataset, click-to-edit. ═══ --}}
<section class="mx-auto max-w-7xl px-6 py-24 sm:py-36">
  <div class="max-w-3xl" data-sw-animation="fade-up">
    <p class="ws-index ws-ink">Pages are code · content is data</p>
    <h2 class="ws-display mt-4 text-4xl font-bold sm:text-6xl" data-sw-text="data_title">Write the loop once. Let anyone edit the rows.</h2>
  </div>
