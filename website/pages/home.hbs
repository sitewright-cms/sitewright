    <div class="ws-window overflow-hidden rounded-2xl" data-sw-animation="fade-up">
      <div class="ws-dots flex items-center gap-1.5 border-b border-white/10 px-4 py-3"><i></i><i></i><i></i><span class="ml-3 font-code text-xs text-white/50">pages/home.hbs</span></div>
<pre class="overflow-x-auto"><code><span class="tk-tag">&lt;div</span> <span class="tk-attr">class</span>=<span class="tk-str">"grid gap-4 sm:grid-cols-3"</span><span class="tk-tag">&gt;</span>
  <span class="tk-hb">\{{#each dataset.home_services}}</span>
  <span class="tk-tag">&lt;article</span> <span class="tk-attr">class</span>=<span class="tk-str">"rounded-xl bg-base-200 p-5"</span><span class="tk-tag">&gt;</span>
    <span class="tk-hb">\{{sw-icon icon "h-7 w-7 text-primary"}}</span>
