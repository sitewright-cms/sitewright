<section class="mx-auto max-w-7xl px-6 py-16 sm:py-24">
  <div class="max-w-3xl" data-sw-animation="fade-up">
    <p class="ws-index ws-ink">03 · Pinned to the viewport</p>
    <h2 class="ws-display mt-3 text-3xl font-bold sm:text-5xl" data-sw-text="b3_title">Look at the bottom left.</h2>
    <p class="mt-4 text-lg leading-relaxed text-base-content/70" data-sw-text="b3_lead">This page has a real floating banner. <code class="font-code text-base">data-delay="scroll"</code> held it back until you scrolled, and <code class="font-code text-base">data-frequency="session"</code> keeps it away for the rest of the browser session once you dismiss it. Without a position it sits bottom right.</p>
  </div>
  <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-start">
    <div class="min-w-0">

<div data-sw-component="banner" data-sw-banner-id="sc-floating" data-position="bottom-left" data-frequency="session" data-delay="scroll" role="status" class="rounded-2xl" hidden>
  <div>
    <p class="font-heading font-semibold">A floating banner</p>
    <p class="text-sm text-base-content/70">It appeared after your first scroll.</p>
  </div>
  <button type="button" class="btn btn-primary btn-sm" data-sw-part="dismiss">Got it</button>
</div>

<div class="ws-window overflow-hidden rounded-2xl">
  <div class="ws-dots flex items-center gap-1.5 border-b border-white/10 px-4 py-3"><i></i><i></i><i></i><span class="ml-3 font-code text-xs text-white/50">banner · floating</span></div>
