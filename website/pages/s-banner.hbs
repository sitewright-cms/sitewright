<section class="border-y border-base-content/10 bg-base-200/50">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24">
    <div class="max-w-3xl" data-sw-animation="fade-up">
      <p class="ws-index ws-ink">04 · Entrance</p>
      <h2 class="ws-display mt-3 text-3xl font-bold sm:text-5xl" data-sw-text="b4_title">Any reveal effect.</h2>
      <p class="mt-4 text-lg leading-relaxed text-base-content/70" data-sw-text="b4_lead">By default a banner fades and rises in. Give it a <code class="font-code text-base">data-sw-animation</code> effect and that runs instead, with the usual delay, duration and easing attributes. The dismissal plays it in reverse. For an inline banner a plain fade reads best.</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">
      <div class="min-w-0">

<div data-sw-component="banner" data-sw-banner-id="sc-entrance" data-position="inline" data-frequency="always" data-sw-animation="fade" data-sw-duration="900" role="status" class="rounded-2xl" hidden>
  {{sw-icon "star-four" "h-5 w-5 shrink-0 text-accent"}}
  <p>This banner faded in over 900 ms. Dismiss it to see the fade run backwards.</p>
  <button type="button" class="btn btn-ghost btn-sm btn-circle" data-sw-part="dismiss" aria-label="Dismiss">{{sw-icon "x:bold" "h-4 w-4"}}</button>
</div>

      </div>
      <div class="min-w-0">
<div class="ws-window overflow-hidden rounded-2xl">
  <div class="ws-dots flex items-center gap-1.5 border-b border-white/10 px-4 py-3"><i></i><i></i><i></i><span class="ml-3 font-code text-xs text-white/50">banner · entrance</span></div>
<pre class="overflow-x-auto"><code><span class="tk-tag">&lt;div</span> <span class="tk-attr">data-sw-component</span>=<span class="tk-str">"banner"</span> <span class="tk-attr">data-sw-banner-id</span>=<span class="tk-str">"sc-entrance"</span> <span class="tk-attr">data-position</span>=<span class="tk-str">"inline"</span> <span class="tk-attr">data-frequency</span>=<span class="tk-str">"always"</span> <span class="tk-attr">data-sw-animation</span>=<span class="tk-str">"fade"</span> <span class="tk-attr">data-sw-duration</span>=<span class="tk-str">"900"</span> <span class="tk-attr">role</span>=<span class="tk-str">"status"</span> <span class="tk-attr">class</span>=<span class="tk-str">"rounded-2xl"</span> <span class="tk-attr">hidden</span><span class="tk-tag">&gt;</span>
  <span class="tk-hb">\{{sw-icon "star-four" "h-5 w-5 shrink-0 text-accent"}}</span>
  <span class="tk-tag">&lt;p</span><span class="tk-tag">&gt;</span>This banner faded in over 900 ms. Dismiss it to see the fade run backwards.<span class="tk-tag">&lt;/p</span><span class="tk-tag">&gt;</span>
  <span class="tk-tag">&lt;button</span> <span class="tk-attr">type</span>=<span class="tk-str">"button"</span> <span class="tk-attr">class</span>=<span class="tk-str">"btn btn-ghost btn-sm btn-circle"</span> <span class="tk-attr">data-sw-part</span>=<span class="tk-str">"dismiss"</span> <span class="tk-attr">aria-label</span>=<span class="tk-str">"Dismiss"</span><span class="tk-tag">&gt;</span><span class="tk-hb">\{{sw-icon "x:bold" "h-4 w-4"}}</span><span class="tk-tag">&lt;/button</span><span class="tk-tag">&gt;</span>
<span class="tk-tag">&lt;/div</span><span class="tk-tag">&gt;</span></code></pre>
</div>
