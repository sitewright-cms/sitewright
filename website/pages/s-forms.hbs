      <span class="tk-tag">&lt;option</span><span class="tk-tag">&gt;</span>Something else<span class="tk-tag">&lt;/option</span><span class="tk-tag">&gt;</span>
    <span class="tk-tag">&lt;/select</span><span class="tk-tag">&gt;</span>
  <span class="tk-tag">&lt;/label</span><span class="tk-tag">&gt;</span>
  <span class="tk-tag">&lt;label</span> <span class="tk-attr">class</span>=<span class="tk-str">"block sm:col-span-2"</span><span class="tk-tag">&gt;</span><span class="tk-tag">&lt;span</span> <span class="tk-attr">class</span>=<span class="tk-str">"mb-1.5 block text-sm font-semibold"</span><span class="tk-tag">&gt;</span>Message<span class="tk-tag">&lt;/span</span><span class="tk-tag">&gt;</span><span class="tk-tag">&lt;textarea</span> <span class="tk-attr">name</span>=<span class="tk-str">"message"</span> <span class="tk-attr">rows</span>=<span class="tk-str">"4"</span> <span class="tk-attr">required</span> <span class="tk-attr">class</span>=<span class="tk-str">"w-full"</span><span class="tk-tag">&gt;</span><span class="tk-tag">&lt;/textarea</span><span class="tk-tag">&gt;</span><span class="tk-tag">&lt;/label</span><span class="tk-tag">&gt;</span>
