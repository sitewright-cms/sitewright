  <span class="tk-tag">&lt;p</span> <span class="tk-attr">class</span>=<span class="tk-str">"mt-3 ws-index text-base-content/60"</span><span class="tk-tag">&gt;</span>near<span class="tk-tag">&lt;/p</span><span class="tk-tag">&gt;</span>
<span class="tk-tag">&lt;/div</span><span class="tk-tag">&gt;</span>
<span class="tk-tag">&lt;div</span> <span class="tk-attr">class</span>=<span class="tk-str">"rounded-3xl border border-base-content/10 bg-base-100 p-8 text-center shadow-lg"</span><span class="tk-tag">&gt;</span>
  <span class="tk-tag">&lt;p</span> <span class="tk-attr">class</span>=<span class="tk-str">"ws-numeral text-5xl"</span><span class="tk-tag">&gt;</span>0<span class="tk-tag">&lt;/p</span><span class="tk-tag">&gt;</span>
  <span class="tk-tag">&lt;p</span> <span class="tk-attr">class</span>=<span class="tk-str">"mt-3 ws-index text-base-content/60"</span><span class="tk-tag">&gt;</span>still<span class="tk-tag">&lt;/p</span><span class="tk-tag">&gt;</span>
<span class="tk-tag">&lt;/div</span><span class="tk-tag">&gt;</span>
