<pre class="overflow-x-auto"><code><span class="tk-tag">&lt;div</span> <span class="tk-attr">data-sw-parallax-translate</span>=<span class="tk-str">"90,-90"</span> <span class="tk-attr">class</span>=<span class="tk-str">"rounded-3xl border border-base-content/10 bg-base-100 p-8 text-center shadow-lg"</span><span class="tk-tag">&gt;</span>
