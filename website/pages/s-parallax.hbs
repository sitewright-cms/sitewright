  <span class="tk-tag">&lt;p</span> <span class="tk-attr">class</span>=<span class="tk-str">"ws-numeral text-5xl"</span><span class="tk-tag">&gt;</span>−30 → 30<span class="tk-tag">&lt;/p</span><span class="tk-tag">&gt;</span>
  <span class="tk-tag">&lt;p</span> <span class="tk-attr">class</span>=<span class="tk-str">"mt-3 ws-index text-base-content/60"</span><span class="tk-tag">&gt;</span>far<span class="tk-tag">&lt;/p</span><span class="tk-tag">&gt;</span>
