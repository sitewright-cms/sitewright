      <span class="tk-tag">&lt;p</span> <span class="tk-attr">class</span>=<span class="tk-str">"ws-display text-4xl font-bold sm:text-6xl"</span><span class="tk-tag">&gt;</span>Depth, from attributes.<span class="tk-tag">&lt;/p</span><span class="tk-tag">&gt;</span>
