<section class="border-y border-base-content/10 bg-base-200/50">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24">
    <div class="max-w-3xl" data-sw-animation="fade-up">
      <p class="ws-index ws-ink">04 · From a dataset</p>
      <h2 class="ws-display mt-3 text-3xl font-bold sm:text-5xl" data-sw-text="t4_title">One tab per row.</h2>
      <p class="mt-4 text-lg leading-relaxed text-base-content/70" data-sw-text="t4_lead">Loop a dataset and each entry becomes a panel. These three come from the dataset behind the cards on this site's home page, so editing a row there changes both.</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">
      <div class="rounded-3xl border border-base-content/10 bg-base-100 p-6">

<div data-sw-component="tabs">
  {{#each dataset.home_services}}
  <div data-sw-part="panel" data-sw-title="{{title}}">
    <div class="flex gap-4 pt-4">
      {{sw-icon icon "h-8 w-8 shrink-0 ws-ink"}}
      <p class="leading-relaxed text-base-content/70">{{summary}}</p>
    </div>
  </div>
  {{/each}}
</div>

      </div>
      <div class="min-w-0">
