{{!-- META {"path":"effects","title":"Borders, buttons and nav effects","description":"A travelling light around any box, 28 button hover effects with shapes and accents, and 19 navigation effects, each one class on the element it decorates. They follow the brand colours in both themes.","parent":"showcase","order":13,"data":{"icon":"magic-wand","preset":"edge-glow"}} --}}
{{> page-hero parent=page.parent}}

<section class="mx-auto max-w-7xl px-6 py-16 sm:py-24">
  <div class="max-w-3xl" data-sw-animation="fade-up">
    <p class="ws-index ws-ink">01 · Border beam</p>
    <h2 class="ws-display mt-3 text-3xl font-bold sm:text-5xl" data-sw-text="f1_title">A light that travels the edge.</h2>
    <p class="mt-4 text-lg leading-relaxed text-base-content/70" data-sw-text="f1_lead"><code class="font-code text-base">sw-border-beam</code> sends a comet around any box in the brand colour. It laps and, on a second timeline, breathes: it spreads along the edge and narrows back. Custom properties on the same element tune it. It needs no script and never covers the content. It repaints every frame, so keep it to one featured box per page; this page breaks that rule on purpose.</p>
  </div>
  <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
<!--demo:beams-->
<div class="sw-border-beam rounded-2xl border border-base-content/10 bg-base-100 p-6">
  <p class="font-heading font-bold">Default</p>
  <p class="mt-2 text-sm text-base-content/70">5px, laps in 1.8s, breathes over 7s.</p>
</div>
<div class="sw-border-beam rounded-2xl bg-base-100 p-6 [--sw-beam-width:2px] [--sw-beam-track:color-mix(in_oklab,var(--sw-color-primary)_25%,transparent)]">
  <p class="font-heading font-bold">Fine edge</p>
  <p class="mt-2 text-sm text-base-content/70">A thin beam over a faint brand track.</p>
</div>
<div class="sw-border-beam rounded-2xl border border-base-content/10 bg-base-100 p-6 [--sw-beam-arc:90deg] [--sw-beam-arc-max:90deg]">
  <p class="font-heading font-bold">Steady comet</p>
  <p class="mt-2 text-sm text-base-content/70">Equal arcs stop the breathing.</p>
</div>
<div class="sw-border-beam rounded-2xl bg-neutral p-6 text-white [--sw-beam-color:var(--sw-color-accent)] [--sw-beam-speed:4s] [--sw-beam-width:3px]">
  <p class="font-heading font-bold">Accent, slower</p>
  <p class="mt-2 text-sm text-white/70">Colour and lap time changed.</p>
</div>
<!--/demo-->
  </div>
  <div class="mt-6">
<!--code:beams file="effects · border beam"-->
  </div>
</section>

<section class="border-y border-base-content/10 bg-base-200/50">
