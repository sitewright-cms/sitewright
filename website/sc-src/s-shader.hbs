{{!-- META {"path":"animated-backgrounds","title":"Animated backgrounds","description":"A WebGL background behind any section, in the site's own colours: 31 presets, tuned with speed, intensity, angle, pointer and colour attributes. Reduced motion gets one still frame, and no JavaScript a CSS gradient.","parent":"showcase","order":9,"data":{"icon":"sparkle","preset":"neuro-noise"}} --}}
{{> page-hero parent=page.parent}}

<section class="mx-auto max-w-7xl px-6 py-16 sm:py-24">
  <div class="max-w-3xl" data-sw-animation="fade-up">
    <p class="ws-index ws-ink">01 · One attribute</p>
    <h2 class="ws-display mt-3 text-3xl font-bold sm:text-5xl" data-sw-text="a1_title">Move your pointer across it.</h2>
    <p class="mt-4 text-lg leading-relaxed text-base-content/70" data-sw-text="a1_lead">This panel is one element with the shader-bg marker and the Neuro Noise preset. The runtime paints a canvas behind the content; an overlay part sits between the two to keep the text legible. With <code class="font-code text-base">data-interactive</code> the pointer bends the field.</p>
  </div>
  <div class="mt-10">
<!--demo:hero-->
<div class="relative grid min-h-[26rem] place-items-center overflow-hidden rounded-3xl px-6 text-center text-white" data-sw-component="shader-bg" data-preset="neuro-noise" data-speed="0.8" data-intensity="0.6" data-colors="primary,accent,neutral" data-interactive="true">
  <div data-sw-part="overlay" class="bg-black/20"></div>
  <div class="max-w-xl">
    <p class="ws-display text-4xl font-bold sm:text-6xl">Neuro Noise</p>
    <p class="mt-4 text-lg text-white/80">No video and no image: a shader, drawn live in the brand colours.</p>
  </div>
</div>
<!--/demo-->
  </div>
  <div class="mt-6">
<!--code:hero file="shader-bg · interactive hero"-->
  </div>
</section>

<section class="border-y border-base-content/10 bg-base-200/50">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24">
    <div class="max-w-3xl" data-sw-animation="fade-up">
      <p class="ws-index ws-ink">02 · Presets</p>
      <h2 class="ws-display mt-3 text-3xl font-bold sm:text-5xl" data-sw-text="a2_title">Pick a look with data-preset.</h2>
      <p class="mt-4 text-lg leading-relaxed text-base-content/70" data-sw-text="a2_lead">Eight of the 31 presets, each in this site's palette. Subtle ones such as Mesh Gradient read best behind text; bold ones such as Plasma or Voronoi Cells suit a decorative band.</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
<!--demo:presets-->
<div class="relative flex h-44 items-end overflow-hidden rounded-2xl p-4" data-sw-component="shader-bg" data-preset="mesh-gradient">
  <span class="rounded-full bg-black/40 px-3 py-1 font-code text-xs text-white backdrop-blur">mesh-gradient</span>
</div>
<!--elide:one tile per preset, the same markup-->
<div class="relative flex h-44 items-end overflow-hidden rounded-2xl p-4" data-sw-component="shader-bg" data-preset="silk-flow">
  <span class="rounded-full bg-black/40 px-3 py-1 font-code text-xs text-white backdrop-blur">silk-flow</span>
</div>
<div class="relative flex h-44 items-end overflow-hidden rounded-2xl p-4" data-sw-component="shader-bg" data-preset="plasma">
  <span class="rounded-full bg-black/40 px-3 py-1 font-code text-xs text-white backdrop-blur">plasma</span>
</div>
<div class="relative flex h-44 items-end overflow-hidden rounded-2xl p-4" data-sw-component="shader-bg" data-preset="caustics">
  <span class="rounded-full bg-black/40 px-3 py-1 font-code text-xs text-white backdrop-blur">caustics</span>
</div>
<div class="relative flex h-44 items-end overflow-hidden rounded-2xl p-4" data-sw-component="shader-bg" data-preset="lava-lamp">
  <span class="rounded-full bg-black/40 px-3 py-1 font-code text-xs text-white backdrop-blur">lava-lamp</span>
</div>
<div class="relative flex h-44 items-end overflow-hidden rounded-2xl p-4" data-sw-component="shader-bg" data-preset="voronoi-cells">
