{{!--
  The close of every feature page: the other features as a compact grid, then the call to action.
    {{> feature-next features=pages.features._attributes.children}}
  The list is PASSED IN, for the same reason as page-hero's parent: the renderer builds a page listing only when
  the page's own source names it.
--}}
<section class="border-t border-base-content/10 bg-base-200/50">
  <div class="mx-auto max-w-7xl px-6 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="ws-display text-3xl font-bold sm:text-4xl">More of the platform</h2>
      <a class="btn btn-ghost btn-sm" href="{{sw-url '/features'}}">All features {{sw-icon "arrow-right" "h-4 w-4"}}</a>
    </div>
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {{#each features}}
      {{#unless (eq path @root.page.path)}}
      <a class="ws-tile rounded-2xl border border-base-content/10 bg-base-100 p-4" href="{{sw-url path}}">
        <span class="flex items-center gap-2 font-heading font-semibold">{{#if data.icon}}{{sw-icon data.icon "h-4 w-4 ws-ink"}}{{/if}}{{title}}</span>
      </a>
      {{/unless}}
      {{/each}}
    </div>
  </div>
</section>
<section class="mx-auto max-w-7xl px-6 py-20">
  <div class="sw-border-beam relative overflow-hidden rounded-[2rem] bg-neutral px-8 py-12 text-white sm:px-14 [--sw-beam-width:2px]">
    <div class="ws-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
    <div class="relative flex flex-wrap items-center justify-between gap-8">
      <div>
        <h2 class="ws-display text-3xl font-bold sm:text-4xl">Run it on your own server.</h2>
        <p class="mt-3 max-w-xl text-white/70">One container, one volume, open source under Apache 2.0.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href="{{sw-url '/docs/getting-started'}}">Get started</a>
        <a class="btn gap-2 border-white/20 bg-white/5 text-white hover:border-white/40 hover:bg-white/10" href="https://github.com/sitewright-cms/sitewright" target="_blank" rel="noopener">{{sw-icon "brand:github" "h-5 w-5"}} GitHub</a>
      </div>
    </div>
  </div>
</section>
